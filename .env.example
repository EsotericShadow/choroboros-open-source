# PACE / AAX signing — copy to `.env` in this same folder and fill in.
# Never put real passwords or WCGUID in THIS file — it is tracked by git.
#
#   cp .env.example .env
#
# Use straight ASCII quotes in .env. If the password contains single quotes,
# use double-quoted ILOK_PASSWORD="..." and escape any " as \"

ILOK_USER=gabreilacroix
ILOK_PASSWORD=
WCGUID=

# Optional: full path to Release Choroboros Beta.aaxplugin. If unset, the script
# tries build/ then Universal-Build/ under this repo.
# External SSD (T7) example — quotes required (spaces in bundle name):
# CHOROBOROS_AAX_PATH="/Volumes/T7/dev/builds/ChoroborosCMakeBuilds/universal/Choroboros_artefacts/Release/AAX/Choroboros Beta.aaxplugin"
# CHOROBOROS_AAX_PATH=

# Optional: override Apple Developer ID string (see: security find-identity -v -p codesigning)
# CHOROBOROS_APP_SIGN_IDENTITY='Developer ID Application: Kaizen Strategic AI Inc. (9XLRQU887D)'

# Set to 1 to skip Apple codesign (bundle already signed with Developer ID)
# SKIP_APPLE_CODESIGN=0

# Set to 1 to pass --allowsigningservice to wraptool sign (no USB signing key)
# WRAPTOOL_ALLOW_SIGNING_SERVICE=0
#
# Pro Tools (macOS) reads AAX from the system folder only:
#   /Library/Application Support/Avid/Audio/Plug-Ins
# Use ./installer/install_aax_pro_tools_system.sh after sign (requires sudo).
#
# Full release .pkg (includes AAX): ./scripts/release_macos_signed_installer.sh needs this .env
# (or CHOROS_MASTER/.env) so sign_aax_pace can run before build_installer.sh.
# CI without PACE: CHOROBOROS_SKIP_AAX_PACKAGE=1 or omit the AAX build artefact.
