<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allows the plugin to load inside DAW hosts signed by other developers.
         Without this, macOS hardened runtime blocks Logic, Ableton, Reaper, etc.
         from loading the plugin. This is required for ALL audio plugins. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Allows the plugin to access microphone/audio input.
         Required for any plugin that processes live audio. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Allows outbound network connections (for license checking,
         update checking, feedback/crash reporting in the future). -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
