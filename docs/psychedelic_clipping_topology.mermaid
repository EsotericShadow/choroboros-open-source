%%{ init: { 'theme': 'dark', 'flowchart': { 'nodeSpacing': 25, 'rankSpacing': 35, 'curve': 'basis' } } }%%
flowchart LR
    IN(["0 dBFS<br/>mono/stereo"])

    IN --> HPF["HPF"] --> PRESAT["Pre-Sat"]

    PRESAT --> SPLIT{ }

    SPLIT -->|"saved as dry"| HOLD["Dry Hold<br/>0 dBFS"]
    SPLIT -->|"in-place → wet"| PREEQ["Pre-Emph"]

    PREEQ --> CORE

    subgraph CORE["Chorus Core — stereo from here"]
        direction TB
        C1["PhaseWarped NQ<br/>depth 0.52 · offset 52°<br/><i>multi-voice + interp</i>"]
    end

    LFO(["LFO<br/>0.12 Hz"]) -.->|"mod"| C1

    CORE --> WCHAR["Wet Char<br/>color 0.13"]
    WCHAR --> POSTSAT["Post-Sat<br/><i>Purple NQ tanh</i>"]

    POSTSAT -->|"× 0.884<br/>(−1.1 dB)"| MIX
    HOLD -->|"× 0.467<br/>(−6.6 dB)"| MIX

    MIX(["DW Mix<br/>balanced · sin/cos"])

    MIX --> PC["Peak Catch<br/>−2 dB · 2∶1 · 4 dB knee<br/>1 ms atk · 100 ms rel"]
    PC --> TRIM["Trim<br/>0 dB default"]
    TRIM --> LPF2["LPF"]

    LPF2 --> WIDTH["M/S Width<br/>side × 2.0<br/>gain comp = 1/√2.5<br/>= 0.632× (−4.0 dB)<br/><i>RMS-safe · NOT peak-safe</i>"]

    WIDTH --> OUT(["DAW output<br/>+13.6 dB L · +12.9 dB R<br/>measured 4.79 / 4.41"])

    style SPLIT fill:none,stroke:none
    style MIX fill:#2a2a4a,stroke:#7a7afa,stroke-width:2px,color:#fff
    style PC fill:#4a3a1a,stroke:#cca020,stroke-width:2px,color:#fff
    style WIDTH fill:#5a1a1a,stroke:#ff4444,stroke-width:2px,color:#fff
    style OUT fill:#5a1a1a,stroke:#ff4444,stroke-width:2px,color:#fff
    style HOLD fill:#1a3a1a,stroke:#4a9a4a,stroke-width:1px,color:#ccc
    style LFO fill:#2a1a3a,stroke:#8a5aba,stroke-width:1px,color:#ccc
    style IN fill:#1a3a2a,stroke:#4aba6a,color:#fff
    style CORE fill:#1a2a3a,stroke:#4a7aaa,color:#fff
    style C1 fill:#1a2a3a,stroke:#4a7aaa,color:#fff
